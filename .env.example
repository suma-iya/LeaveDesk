# Copy to .env and adjust:  cp .env.example .env

# Postgres
POSTGRES_DB=leave_tracker
POSTGRES_USER=leave
POSTGRES_PASSWORD=leave_secret

# JWT signing key: at least 16 characters, keep it secret.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=24h

# Google Sign-In (optional). Create an OAuth 2.0 "Web application" client in
# Google Cloud Console and add http://localhost:3000 to Authorized JavaScript origins.
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Google accounts with these emails become MANAGER on first sign-in (comma separated).
MANAGER_EMAILS=

# First manager account, created on startup if it does not exist.
SEED_MANAGER_NAME=Default Manager
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=manager123

# Adds 3 demo employees (password: password123) with sample leaves on an empty DB.
SEED_DEMO_DATA=true

# Decides which calendar day a request "came in" on.
APP_TIMEZONE=Asia/Dhaka

FRONTEND_PORT=3000
