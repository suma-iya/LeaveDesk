# Copy to .env:  cp .env.example .env

# Required: key that signs session cookies (at least 16 characters).
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL=8h
# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false

POSTGRES_DB=leavedesk
POSTGRES_USER=leavedesk
POSTGRES_PASSWORD=leavedesk_secret

# Decides which calendar day "today" is.
APP_TIMEZONE=Asia/Dhaka

# Default yearly leave allowance per type (HR can override per employee and year).
LEAVE_DEFAULT_ANNUAL=16
LEAVE_DEFAULT_CASUAL=3
LEAVE_DEFAULT_SICK=3

# Optional: only allow sign-ups from these email domains (comma separated).
ALLOWED_EMAIL_DOMAINS=

# Optional "Continue with Google". Create an OAuth client (Web application) in
# Google Cloud Console with redirect URI http://localhost:3000/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/google/callback

FRONTEND_PORT=3000
